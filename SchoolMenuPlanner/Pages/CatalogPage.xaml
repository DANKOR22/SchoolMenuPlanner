<Page x:Class="SchoolMenuPlanner.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SchoolMenuPlanner"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="CatalogPage"
      Loaded="Page_Loaded">
    <Page.Resources>
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#B255FF"/>
            <Setter Property="BorderBrush" Value="#E1E8ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.1" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategorySection" TargetType="Border">
            <Setter Property="Background" Value="#D6BCFA"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Новый стиль для центрирования текста в TextBox -->
        <Style x:Key="CenteredTextBox" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Стиль для центрированных заголовков -->
        <Style x:Key="CenteredHeader" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <Grid Background="#A436FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#C177FF" Padding="20,15" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🍎 Каталог блюд" 
                   FontSize="30" FontWeight="Bold" Foreground="#2D3748" FontFamily="Comic Sans MS"/>

                <ComboBox Grid.Column="2" Width="200" 
                  SelectedIndex="0" Padding="10" FontFamily="Comic Sans MS" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"
                          x:Name="ComboBoxItemMenu" SelectionChanged="ComboBoxItemMenu_Selected">
                    <ComboBoxItem Content="Архив меню" Tag="CatalogPage"/>
                    <ComboBoxItem Content="Следущая неделя" Tag="NextWeekPage"/>
                    <ComboBoxItem Content="Текущая неделя" Tag="WeekPage"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Border Grid.Row="1" Margin="20" Style="{StaticResource ModernCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0" Text="Все категории блюд" 
                               FontSize="24" FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               FontFamily="Comic Sans MS"
                               Margin="0,0,0,20"/>

                    <!-- Списки блюд - 4 колонки -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Колонка 1: Горячее блюдо и Горячее первое -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">
                            <!-- Горячее блюдо -->
                            <Border Style="{StaticResource CategorySection}">
                                <TextBlock Text="🍳 Горячее блюдо" FontSize="16" Style="{StaticResource CenteredHeader}"/>
                            </Border>

                            <TextBlock Text="+" TextAlignment="Center" 
                                       FontSize="25" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Stretch" 
                                       Foreground="Green"
                                       Cursor="Hand"
                                       MouseDown="AddTextBox_Click"
                                       Tag="HotDishes"
                                       Margin="0,5"
                                       Background="White"
                                       Padding="10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="200"
                                          Padding="0">
                                <ListView Background="Transparent" 
                                          x:Name="HotDishesListView"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                         Style="{StaticResource CenteredTextBox}"
                                                         LostFocus="TextBox_LostFocus"/>
                                                <TextBlock Text="✕" 
                                                           FontSize="14" 
                                                           TextAlignment="Center" 
                                                           Grid.Column="1"
                                                           Cursor="Hand"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MouseDown="RemoveItem_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>

                            <!-- Горячее первое -->
                            <Border Style="{StaticResource CategorySection}" Margin="0,15,0,0">
                                <TextBlock Text="🍲 Горячее первое" FontSize="16" Style="{StaticResource CenteredHeader}"/>
                            </Border>

                            <TextBlock Text="+" TextAlignment="Center" 
                                       FontSize="25" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Stretch" 
                                       Foreground="Green"
                                       Cursor="Hand"
                                       MouseDown="AddTextBox_Click"
                                       Tag="HotFirst"
                                       Margin="0,5"
                                       Background="White"
                                       Padding="10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="150"
                                          Padding="0">
                                <ListView Background="Transparent" 
                                          x:Name="HotFirstListView"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                         Style="{StaticResource CenteredTextBox}"
                                                         LostFocus="TextBox_LostFocus"/>
                                                <TextBlock Text="✕" 
                                                           FontSize="14" 
                                                           TextAlignment="Center" 
                                                           Grid.Column="1"
                                                           Cursor="Hand"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MouseDown="RemoveItem_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Колонка 2: Второе и Гарнир -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                            <!-- Второе -->
                            <Border Style="{StaticResource CategorySection}">
                                <TextBlock Text="🍚 Второе" FontSize="16" Style="{StaticResource CenteredHeader}"/>
                            </Border>

                            <TextBlock Text="+" TextAlignment="Center" 
                                       FontSize="25" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Stretch" 
                                       Foreground="Green"
                                       Cursor="Hand"
                                       MouseDown="AddTextBox_Click"
                                       Tag="SecondDishes"
                                       Margin="0,5"
                                       Background="White"
                                       Padding="10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="200"
                                          Padding="0">
                                <ListView Background="Transparent" 
                                          x:Name="SecondDishesListView"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                         Style="{StaticResource CenteredTextBox}"
                                                         LostFocus="TextBox_LostFocus"/>
                                                <TextBlock Text="✕" 
                                                           FontSize="14" 
                                                           TextAlignment="Center" 
                                                           Grid.Column="1"
                                                           Cursor="Hand"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MouseDown="RemoveItem_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>

                            <!-- Гарнир -->
                            <Border Style="{StaticResource CategorySection}" Margin="0,15,0,0">
                                <TextBlock Text="🍖 Гарнир" FontSize="16" Style="{StaticResource CenteredHeader}"/>
                            </Border>

                            <TextBlock Text="+" TextAlignment="Center" 
                                       FontSize="25" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Stretch" 
                                       Foreground="Green"
                                       Cursor="Hand"
                                       MouseDown="AddTextBox_Click"
                                       Tag="Garnish"
                                       Margin="0,5"
                                       Background="White"
                                       Padding="10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="150"
                                          Padding="0">
                                <ListView Background="Transparent" 
                                          x:Name="GarnishListView"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                         Style="{StaticResource CenteredTextBox}"
                                                         LostFocus="TextBox_LostFocus"/>
                                                <TextBlock Text="✕" 
                                                           FontSize="14" 
                                                           TextAlignment="Center" 
                                                           Grid.Column="1"
                                                           Cursor="Hand"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MouseDown="RemoveItem_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Колонка 3: Салат и Напиток -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Stretch">
                            <!-- Салат -->
                            <Border Style="{StaticResource CategorySection}">
                                <TextBlock Text="🥗 Салат" FontSize="16" Style="{StaticResource CenteredHeader}"/>
                            </Border>

                            <TextBlock Text="+" TextAlignment="Center" 
                                       FontSize="25" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Stretch" 
                                       Foreground="Green"
                                       Cursor="Hand"
                                       MouseDown="AddTextBox_Click"
                                       Tag="Salads"
                                       Margin="0,5"
                                       Background="White"
                                       Padding="10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="200"
                                          Padding="0">
                                <ListView Background="Transparent" 
                                          x:Name="SaladsListView"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                         Style="{StaticResource CenteredTextBox}"
                                                         LostFocus="TextBox_LostFocus"/>
                                                <TextBlock Text="✕" 
                                                           FontSize="14" 
                                                           TextAlignment="Center" 
                                                           Grid.Column="1"
                                                           Cursor="Hand"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MouseDown="RemoveItem_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>

                            <!-- Напиток -->
                            <Border Style="{StaticResource CategorySection}" Margin="0,15,0,0">
                                <TextBlock Text="🥤 Напиток" FontSize="16" Style="{StaticResource CenteredHeader}"/>
                            </Border>

                            <TextBlock Text="+" TextAlignment="Center" 
                                       FontSize="25" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Stretch" 
                                       Foreground="Green"
                                       Cursor="Hand"
                                       MouseDown="AddTextBox_Click"
                                       Tag="Drinks"
                                       Margin="0,5"
                                       Background="White"
                                       Padding="10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="150"
                                          Padding="0">
                                <ListView Background="Transparent" 
                                          x:Name="DrinksListView"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                         Style="{StaticResource CenteredTextBox}"
                                                         LostFocus="TextBox_LostFocus"/>
                                                <TextBlock Text="✕" 
                                                           FontSize="14" 
                                                           TextAlignment="Center" 
                                                           Grid.Column="1"
                                                           Cursor="Hand"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MouseDown="RemoveItem_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Колонка 4: Фрукты -->
                        <StackPanel Grid.Column="6" HorizontalAlignment="Stretch">
                            <!-- Фрукты -->
                            <Border Style="{StaticResource CategorySection}">
                                <TextBlock Text="🍎 Фрукты" FontSize="16" Style="{StaticResource CenteredHeader}"/>
                            </Border>

                            <TextBlock Text="+" TextAlignment="Center" 
                                       FontSize="25" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Stretch" 
                                       Foreground="Green"
                                       Cursor="Hand"
                                       MouseDown="AddTextBox_Click"
                                       Tag="Fruits"
                                       Margin="0,5"
                                       Background="White"
                                       Padding="10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="200"
                                          Padding="0">
                                <ListView Background="Transparent" 
                                          x:Name="FruitsListView"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                         Style="{StaticResource CenteredTextBox}"
                                                         LostFocus="TextBox_LostFocus"/>
                                                <TextBlock Text="✕" 
                                                           FontSize="14" 
                                                           TextAlignment="Center" 
                                                           Grid.Column="1"
                                                           Cursor="Hand"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           MouseDown="RemoveItem_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Статус бар -->
        <StatusBar x:Name="MainStatusBar" Grid.Row="2" Background="#C177FF" BorderBrush="#E1E8ED" BorderThickness="1,0,0,0">
            <StatusBarItem>
                <TextBlock Text="Каталог блюд" Foreground="Black" FontFamily="Comic Sans MS" FontSize="14"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TotalDishesText" Text="Всего блюд: " Foreground="Black" FontFamily="Comic Sans MS" FontSize="14"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Пятница -->
                <TabItem Header="Пятница" FontFamily="Comic Sans MS" FontSize="18">
                    <Border Style="{StaticResource ModernCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовки -->
                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource MealSection}">
                                        <TextBlock Text="🍳 Завтрак" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Comic Sans MS"/>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource MealSection}">
                                        <TextBlock Text="🍽️ Обед" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Comic Sans MS"/>
                                    </Border>
                                </Grid>

                                <!-- Списки блюд -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Завтрак -->
                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🍚 Горячее блюдо" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="FridayBreakfastHotDish" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding HotDishesItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🥤 Напиток" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="FridayBreakfastDrink" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding DrinksItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🍎 Фрукты" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="FridayBreakfastFruit" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding FruitsItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Обед -->
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🍲 Горячее первое" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="FridayLunchHotFirst" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding HotFirstItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🍖 Второе" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="FridayLunchSecond" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding SecondDishesItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Добавлен Гарнир -->
                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🥘 Гарнир" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="FridayLunchGarnish" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding GarnishItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🥗 Салат" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="FridayLunchSalad" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding SaladsItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🥤 Напиток" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="FridayLunchDrink" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding DrinksItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </TabItem>

            </TabControl>
        </ScrollViewer>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Background="#C177FF" BorderBrush="#E1E8ED" BorderThickness="1,0,0,0">
            <StatusBarItem>
                <TextBlock Text="Готово к сохранению" Foreground="Green" FontFamily="Comic Sans MS" FontSize="14"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Сохранить меню" Click="SaveMenu_Click" 
                        FontFamily="Comic Sans MS" FontSize="14" 
                        Background="#4CAF50" Foreground="White" 
                        Padding="10,5" Margin="5"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>
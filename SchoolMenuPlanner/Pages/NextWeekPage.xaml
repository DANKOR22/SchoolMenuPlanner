                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource MealSection}">
                                        <TextBlock Text="🍳 Завтрак" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Comic Sans MS"/>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource MealSection}">
                                        <TextBlock Text="🍽️ Обед" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Comic Sans MS"/>
                                    </Border>
                                </Grid>

                                <!-- Списки блюд -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Завтрак -->
                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🍚 Горячее блюдо" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="MondayBreakfastHotDish" Style="{StaticResource ComboBoxStyle}" 
                                                          ItemsSource="{Binding HotDishesItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🥤 Напиток" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="MondayBreakfastDrink" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding DrinksItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🍎 Фрукты" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="MondayBreakfastFruit" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding FruitsItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Обед -->
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🍲 Горячее первое" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="MondayLunchHotFirst" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding HotFirstItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🍖 Второе" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="MondayLunchSecond" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding SecondDishesItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Добавлен Гарнир -->
                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🥘 Гарнир" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="MondayLunchGarnish" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding GarnishItems}"

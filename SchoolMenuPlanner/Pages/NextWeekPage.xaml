                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CategorySection}">
                                            <StackPanel>
                                                <TextBlock Text="🥗 Салат" FontSize="18" FontWeight="Bold" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="MondayLunchSalad" Style="{StaticResource ComboBoxStyle}"
                                                          ItemsSource="{Binding SaladsItems}"

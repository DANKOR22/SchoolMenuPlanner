                                                          ItemsSource="{Binding DrinksItems}"
                                                          DisplayMemberPath="Name"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>

<Window x:Class="SchoolMenuPlanner.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SchoolMenuPlanner"
        mc:Ignorable="d"
        Title="Авторизация" 
        Height="600" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#B255FF"/>
            <Setter Property="BorderBrush" Value="#A436FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.5" BlurRadius="010"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputSection" TargetType="Border">
            <Setter Property="Background" Value="#D6BCFA"/>
            <Setter Property="BorderBrush" Value="#B255FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" 
                            BlurRadius="20" 
                            Color="White" 
                            Opacity="0.5"/>
            </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" 
                BlurRadius="20" 
                Color="White" 
                Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3d8b40"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#A436FF">
        <Border Style="{StaticResource ModernCard}" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Width="400" Height="450">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" Color="#A436FF" ShadowDepth="0"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- Заголовок -->
                <Border Style="{StaticResource InputSection}">
                    <TextBlock Text="🍎 Школьное меню" 
                               FontSize="25" 
                               FontWeight="Bold" 
                               Foreground="#2D3748" 
                               FontFamily="Comic Sans MS"
                               HorizontalAlignment="Center"/>

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#B255FF" ShadowDepth="0"/>
                    </Border.Effect>
                </Border>

                <!-- Подзаголовок -->
                <TextBlock Text="Авторизация" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           FontFamily="Comic Sans MS"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Поле логина -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Логин" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               FontFamily="Comic Sans MS"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="UsernameTextBox" 
                             Style="{StaticResource TextBoxStyle}"
                             Height="45"
                             GotFocus="UsernameTextBox_GotFocus"
                             LostFocus="UsernameTextBox_LostFocus"/>
                </StackPanel>

                <!-- Поле пароля -->
                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="Пароль" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               FontFamily="Comic Sans MS"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Style="{StaticResource PasswordBoxStyle}"
                                 Height="45"
                                 GotFocus="PasswordBox_GotFocus"
                                 LostFocus="PasswordBox_LostFocus"
                                 />
                </StackPanel>

                <!-- Кнопка входа -->
                <Button x:Name="LoginButton" 
                        Content="Войти" 
                        Style="{StaticResource LoginButtonStyle}"
                        Click="LoginButton_Click"
                        Height="50" />

                <!-- Сообщение об ошибке -->
                <TextBlock x:Name="ErrorTextBlock" 
                           Text="" 
                           FontSize="14" 
                           Foreground="#FF6B6B" 
                           FontFamily="Comic Sans MS"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
<Page x:Class="SchoolMenuPlanner.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SchoolMenuPlanner"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="CatalogPage">
    <Page.Resources>
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#B255FF"/>
            <Setter Property="BorderBrush" Value="#E1E8ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.1" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MealSection" TargetType="Border">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="DishItem" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EDF2F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Page.Resources>

    <Grid Background="#A436FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#C177FF" Padding="20,15" BorderBrush="#E1E8ED" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🍎 Каталог блюд" 
                   FontSize="30" FontWeight="Bold" Foreground="#2D3748" FontFamily="Comic Sans MS"/>

                <ComboBox Grid.Column="2" Width="200" 
                  SelectedIndex="0" Padding="10" FontFamily="Comic Sans MS" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Архив меню"/>
                    <ComboBoxItem Content="Следущая неделя"/>
                    <ComboBoxItem Content="Текущая неделя"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Основной контент - без вкладок -->
        <Border Grid.Row="1" Margin="20" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовки разделов -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MealSection}">
                        <TextBlock Text="Завтрак" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Comic Sans MS"/>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MealSection}">
                        <TextBlock Text="Обед" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Comic Sans MS"/>
                    </Border>
                </Grid>

                <!-- Списки блюд -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Завтрак -->
                    <StackPanel Grid.Column="0" x:Name="BreakfastPanel">
                        <TextBlock Text="+" TextAlignment="Center" 
                   FontSize="30" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Stretch" 
                   Foreground="Green"
                   Cursor="Hand"
                   MouseDown="AddTextBox_Click"
                   Tag="Breakfast"
                   Margin="0,10"
                                   Background="White"/>

                        <ListView Background="Transparent" x:Name="BreakfastListView">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="400">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95*"/>
                                            <ColumnDefinition Width="5*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- В шаблоне ListView для TextBox -->
                                        <TextBox Text="{Binding Name}" 
         FontSize="20" 
         FontFamily="Comic Sans MS"
         TextAlignment="Center" 
         Foreground="Black" 
         Grid.Column="0"
         LostFocus="TextBox_LostFocus"/>
                                        <!-- Этот обработчик -->

                                        <!-- В шаблоне ListView для кнопки удаления -->
                                        <TextBlock Text="✕" 
           FontSize="20" 
           TextAlignment="Center" 
           Grid.Column="1"
           Cursor="Hand"
           MouseDown="RemoveItem_Click"/>
                                        <!-- Этот обработчик -->
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Обед -->
                    <StackPanel Grid.Column="2" x:Name="LunchPanel">
                        <TextBlock Text="+" Background="White" TextAlignment="Center" 
                   FontSize="30" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Stretch" 
                   Foreground="Green"
                   Cursor="Hand"
                   MouseDown="AddTextBox_Click"
                   Tag="Lunch"
                   Margin="0,10"/>

                        <ListView Background="Transparent" x:Name="LunchListView">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="400">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95*"/>
                                            <ColumnDefinition Width="5*"/>
                                        </Grid.ColumnDefinitions>

                                            <TextBox Text="{Binding Name}" 
                                             FontSize="20" 
                                             FontFamily="Comic Sans MS"
                                             TextAlignment="Center" 
                                             Foreground="Black" 
                                             Grid.Column="0"
                                             LostFocus="TextBox_LostFocus"/>  
                                        
                                            <TextBlock Text="✕" 
                                   FontSize="20" 
                                   TextAlignment="Center" 
                                   Grid.Column="1"
                                   Cursor="Hand"
                                   MouseDown="RemoveItem_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Статус бар -->
        <StatusBar x:Name="MainStatusBar" Grid.Row="2" Background="#C177FF" BorderBrush="#E1E8ED" BorderThickness="1,0,0,0">
            <StatusBarItem>
                <TextBlock Text="Каталог блюд" Foreground="Black" FontFamily="Comic Sans MS" FontSize="14"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TotalDihesText" Text="Всего блюд: " Foreground="Black" FontFamily="Comic Sans MS" FontSize="14"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>